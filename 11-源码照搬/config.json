{
  "_readme": "工作台启动配置。`启动.vbs`、`外壳\\start.vbs`、`外壳\\main.js` 三处都从这一份文件读参数，改这里就行，不用再改脚本。路径既可以是相对工作台根目录的相对路径，也可以是绝对路径。端口/数据目录改动后必须重启外壳才生效。",
  "port": 33083,
  "shellDir": "外壳",
  "engineDir": "引擎",
  "engineDataDir": "引擎数据\\.dsh",
  "electronExe": "外壳\\node_modules\\electron\\dist\\electron.exe",
  "electronArgs": ". --remote-debugging-port=9222",
  "windowStyle": 1,
  "clearEnv": "ELECTRON_RUN_AS_NODE",
  "window": {
    "width": 1380,
    "height": 900,
    "minWidth": 1000,
    "minHeight": 660
  },
  "boot": {
    "budgetSec": 120,
    "logMaxBytes": 4194304
  }
